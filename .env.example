# Local default is SQLite; docker compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./uae_cards.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/uae_cards
ENVIRONMENT=local
# Optional. Without it the deterministic explanation is used and everything still works.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
MIN_INCREMENTAL_VALUE=250
STALENESS_DAYS=180

# Firecrawl retrieval layer. Without it the research pipeline runs in replay mode
# against cached documents and will not reach the network.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT=120
RESEARCH_CACHE_DIR=.research_cache
RESEARCH_CACHE_TTL_HOURS=168
